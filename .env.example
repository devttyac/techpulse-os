# TechPulse OS Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Gates every /api/* route via the X-API-Key header. Leave blank for read-only
# mode (GET requests only). Generate a value with: openssl rand -hex 32
API_SECRET_KEY=
HOST_URL=http://10.0.0.50:8000
CRON_SCHEDULE=0 6 * * *
STORAGE_DIR=/app/data
PORT=8000